# Environment Variables for Zone Store Membership Backend

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=zonesupply_membership

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1d

# Admin Credentials (hashed on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zone@123

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload (local for dev, set to 'cloudinary' for prod)
UPLOAD_MODE=local
MAX_FILE_SIZE=5242880

# Cloudinary (optional, for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
